{
  "name": "brandki-demo",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "app:dev": "vite --port 5180 & sleep 2 && VITE_DEV_SERVER_URL=http://localhost:5180 electron .",
    "app:build": "npm run build && NODE_TLS_REJECT_UNAUTHORIZED=0 electron-builder --mac dir",
    "app:dmg": "npm run build && NODE_TLS_REJECT_UNAUTHORIZED=0 electron-builder --mac dmg",
    "app:build:win": "npm run build && NODE_TLS_REJECT_UNAUTHORIZED=0 electron-builder --win nsis portable --x64 --arm64"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^3.0.2",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.brandki.app",
    "productName": "Brandki",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Brandki-Setup-${version}-${arch}.exe",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Brandki-Portable-${version}-${arch}.exe"
    }
  }
}
